# All optional. Missing values degrade gracefully; nothing crashes.

# Model step. Without this, tickets are template-only (still filed).
ANTHROPIC_API_KEY=
PATCHWATCH_MODEL=claude-sonnet-5
# Set to 1 only if your endpoint predates output_config.format
PATCHWATCH_SCHEMA_COMPAT=

# Free key. Raises NVD from 5 to 50 requests per 30s.
NVD_API_KEY=

# Jira. Without these, no tickets are filed.
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=SEC
JIRA_ISSUE_TYPE=Task

# Urgent path for KEV / actively-exploited CVEs. At least one is strongly recommended.
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# Point at your own SOFA fork once self-hosted.
SOFA_BASE=https://sofafeed.macadmins.io

# Optional extras
PATCHWATCH_PIXEL=0
PATCHWATCH_EDGE=0

# --- Email digest -----------------------------------------------------------
# Gmail: smtp.gmail.com / 587 / an APP PASSWORD (not your account password;
#   requires 2FA enabled). Office 365: smtp.office365.com / 587.
# SMTP_SSL=1 switches to implicit TLS on 465 instead of STARTTLS on 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=
EMAIL_FROM=
EMAIL_TO=security-team@example.com,you@example.com
EMAIL_SUBJECT_PREFIX=[patchwatch]
EMAIL_MIN_INTERVAL_HOURS=4
